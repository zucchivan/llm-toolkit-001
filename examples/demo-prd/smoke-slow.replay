{"tool": "write", "path": "src/list.ts", "content": "export function parseList(input: string): string[] {\n\treturn input.split('/').flatMap((p) => p.split(',')).map((s) => s.trim()).filter((s) => s.length > 0 && !s.startsWith('-'));\n}\n"}
