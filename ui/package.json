{
  "name": "llm-toolkit-001-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local web control surface for one llm-toolkit-001 loop — plan/approve/run/stop control + detached jobs + diffs + health/keyboard/a11y polish (M3)",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "llm-toolkit-ui": "bin/llm-toolkit-ui.js"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig tsconfig.json",
    "dev": "vite build && node bin/llm-toolkit-ui.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "KIT_FAUX=1 KIT_FAUX_SCRIPT=smoke.replay vitest run test/e2e-real-cli.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
